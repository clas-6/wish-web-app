rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      // Anyone logged in can read open wishes
      allow read: if request.auth != null;
      
      // Only the owner can create a wish, must initialize correctly
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.amount_paid == 0;
      
      // Only Cloud Functions should update progress; users can't edit or delete active wishes for integrity
      allow update, delete: if false; 
    }
  }
}